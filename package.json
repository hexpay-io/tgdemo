{
  "name": "hexpay-air-store-bot",
  "version": "1.0.0",
  "description": "A humorous Telegram bot that sells bottled air using HexPay crypto payments",
  "main": "dist/index.js",
  "scripts": {
    "generate:client": "npx openapi-typescript oapi.yaml -o src/generated/schema.ts",
    "build": "npm run generate:client && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "crypto",
    "payments",
    "hexpay",
    "air"
  ],
  "author": "HexPay",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "node-telegram-bot-api": "^0.64.0",
    "openapi-fetch": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-telegram-bot-api": "^0.64.13",
    "openapi-typescript": "^6.7.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
